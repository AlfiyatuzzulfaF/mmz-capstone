# ==============================================================================
# MMZ Studio Foto - Environment Variables Template (.env.example)
# Sistem Informasi Pemantauan Operasional & Manajemen Transaksi
# ==============================================================================

# --- TiDB Cloud Database Connection (MySQL Wire Protocol with TLS/SSL) ---
# Default port 4000. TLSv1.2 encryption is mandatory for TiDB Cloud AWS clusters.
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=4sCAPxEEYcGBndR.root
DB_PASSWORD=your_secure_tidb_password
DB_NAME=test
DB_SSL=true

# --- n8n Workflow Automation Engine (WhatsApp Bot & Notifications) ---
# Webhook URL for outbound automated WhatsApp booking confirmation (KF-12)
N8N_WEBHOOK_URL=https://n8n.yourstudio.com/webhook/mmz-booking-notification

# --- Google Calendar API v3 Integration ---
# Calendar IDs for Studio 1 and Studio 2 (KF-05, KF-11)
GOOGLE_CALENDAR_STUDIO_1_ID=studio1_calendar_id@group.calendar.google.com
GOOGLE_CALENDAR_STUDIO_2_ID=studio2_calendar_id@group.calendar.google.com
